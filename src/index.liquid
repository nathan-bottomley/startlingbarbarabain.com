---
title: Startling Barbara Bain
permalink: "/{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber | plus: 1 }}/{% endif %}"
layout: layouts/base
includeAudioPlayer: true
pagination:
  data: collections.episodePost
  size: 10
  reverse: true
  alias: posts
  addAllPagesToCollections: true
---

{% for post in posts %}
{% if forloop.first %}
  {% render 'full-episode.liquid' with post as post, linkInTitle: true %}
{% else %}
  {% render 'listed-episode.liquid' with post as post %}
{% endif %}
{% endfor %}

<nav class="pagination navigation-previous-next" aria-label="Pagination navigation">
  {% if pagination.href.next %}
    <a href="{{ pagination.href.next }}" class="previous">&larr;&nbsp;Older Episodes</a>
  {% else %}
  <span></span>
  {% endif %}
  {% if pagination.href.previous %}
    <a href="{{ pagination.href.previous }}" class="next">
      Newer Episodes&nbsp;&rarr;
    </a>
  {% endif %}
</nav>
